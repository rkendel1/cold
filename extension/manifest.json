{
  "manifest_version": 3,
  "name": "Cold",
  "version": "0.1.0",
  "description": "Write replies, tweets and cold emails from the page you're on, using your products and the model you chose in the Cold app.",
  "minimum_chrome_version": "114",
  "action": { "default_title": "Open Cold" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "sidePanel", "scripting", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.linkedin.com/*"
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
