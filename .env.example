LLM_PROVIDER=ai-gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.5
LLM_MAX_TOKENS=2000
# For direct Anthropic: set LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY
# Local models via Ollama (no API key): set LLM_PROVIDER=ollama, then `ollama pull llama3.1`
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# SQLite storage for products and drafts (desktop app sets this itself). Needs Node 22.13+.
# Optional Google sign-in for a HOSTED web deployment (identity only; see docs/google-sign-in.md). Leave all unset to keep it off.
# COLD_AUTH_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# COLD_AUTH_GOOGLE_CLIENT_SECRET=<server-side secret from Google Cloud Console>
# COLD_AUTH_REDIRECT_URI=https://your-host.example/oauth/account/callback
# COLD_SESSION_SECRET=<32+ random characters, e.g. from: openssl rand -base64 32>
# COLD_ACCOUNTS_DB_FILE=/persistent/path/accounts.db
# Optional account-owned hosted libraries on this server (needs sign-in and a persistent disk; a SEPARATE file; see docs/hosted-library.md):
# COLD_DATA_DB_FILE=/persistent/path/hosted.db
# Allow the desktop app and the Chrome extension to sign in to THIS server (exact redirect URIs, also registered with Google):
# COLD_AUTH_NATIVE_REDIRECTS=http://127.0.0.1:47821/oauth/account/callback,https://<extension-id>.chromiumapp.org/
# On a desktop or extension BUILD (not the server), point it at that server: COLD_ACCOUNT_URL=https://your-host.example
# COLD_DB_FILE=/path/to/cold.db
# COLD_SETTINGS_FILE=/path/to/settings.json

# Import product knowledge from a repository (optional): raises GitHub rate limits / reads private repos the token can access
# COLD_GITHUB_TOKEN=
