LLM_PROVIDER=ai-gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.5
LLM_MAX_TOKENS=2000
# For direct Anthropic: set LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY
# Local models via Ollama (no API key): set LLM_PROVIDER=ollama, then `ollama pull llama3.1`
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://127.0.0.1:11434
