{
  "name": "cold",
  "version": "0.1.0",
  "private": true,
  "description": "A focused cold-email generator. Give it five facts; it gives you an email worth sending.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "build:app": "node scripts/build-app.cjs",
    "check:app": "node scripts/build-app.cjs --check",
    "test:hf-ssh": "node scripts/hf-ssh-smoke.cjs",
    "build:tweet-counter": "esbuild scripts/tweet-counter.cjs --bundle --minify --outfile=public/tweet-counter.js",
    "desktop": "electron desktop/main.js",
    "desktop:build": "npm run build:app && electron-builder",
    "desktop:pack": "npm run build:app && electron-builder --dir",
    "build:extension": "node scripts/build-extension.cjs",
    "pin:local-model": "node scripts/pin-local-model.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "twitter-text": "^3.1.0"
  },
  "devDependencies": {
    "axe-core": "4.10.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "1.56.1"
  },
  "author": "Kendel Consulting <randy@kendelconsulting.com>",
  "build": {
    "appId": "com.kendelconsulting.cold",
    "productName": "Cold",
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "files": [
      "desktop/**",
      "lib/**",
      "public/**",
      "index.html",
      "server.js",
      "provider-config.json",
      "scripts/hf-ssh-provider.cjs",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
